# =============================================================================
# SolarPulse AI — Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15 + TimescaleDB)
# -----------------------------------------------------------------------------
POSTGRES_USER=solarpulse
POSTGRES_PASSWORD=solarpulse_secret
POSTGRES_DB=solarpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Async Database Connection URL
DATABASE_URL=postgresql+asyncpg://solarpulse:solarpulse_secret@localhost:5432/solarpulse

# -----------------------------------------------------------------------------
# Redis Configuration (Cache & Task Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication & JWT Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_secure_random_key_min_32_characters_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Numerical Weather Prediction (NWP) API Connectors
# -----------------------------------------------------------------------------
NWP_API_PROVIDER=open-meteo       # Supported: open-meteo, ecmwf, nrel
NWP_API_KEY=demo_key_or_leave_empty_for_open_meteo

# -----------------------------------------------------------------------------
# Machine Learning & Physics Pipeline
# -----------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=./backend/ml/artifacts/models
ANOMALY_PERSISTENCE_STEPS=3       # Number of consecutive timesteps before firing alert
DEFAULT_ALERT_THRESHOLD_PCT=10.0  # Alert triggered if (Forecast - Actual) / Forecast > 10%

# -----------------------------------------------------------------------------
# Frontend (Next.js 15) Environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=replace_with_a_secure_nextauth_secret_for_production
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Operational / Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                    # Options: DEBUG, INFO, WARNING, ERROR
ENVIRONMENT=development           # Options: development, staging, production
