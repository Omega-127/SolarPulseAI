# ══════════════════════════════════════════════════════════════════
# Solar Forecast API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_NAME=Solar Forecast API
APP_VERSION=1.0.0
DEBUG=true

# ── Database ──────────────────────────────────────────────────────
# Use asyncpg driver for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solar_forecast

# ── JWT ───────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET_KEY to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── ML Model ──────────────────────────────────────────────────────
# Path to the LightGBM model file (relative to backend/ directory)
# If file does not exist, a development fallback is used automatically
ML_MODEL_PATH=models/lightgbm_model.txt

# ── NWP / Weather API (optional) ──────────────────────────────────
# Leave empty to use mock weather data for local development
NWP_API_URL=
NWP_API_KEY=
